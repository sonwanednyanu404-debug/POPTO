{
  "expo": {
    "name": "POPTO",
    "slug": "popto",
    "owner": "popto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#183D2B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.popto.app"
    },
    "android": {
      "package": "in.popto.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#183D2B"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "aad5f7e8-67f0-4c2e-a263-dd4eebc0b5ce"
      }
    }
  }
}
