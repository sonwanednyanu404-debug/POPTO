# Environment Variables for POPTO
# Copy this file to .env.local and fill in your values

# ── Database ──────────────────────────────────────────────
# SQLite database path (auto-created)
DATABASE_PATH=./data/popto.db

# ── Authentication ────────────────────────────────────────
# Secret key for JWT token signing (change in production!)
AUTH_SECRET=change-this-to-a-random-secret-string-min-32-chars

# JWT token expiry
AUTH_TOKEN_EXPIRY=7d

# ── Admin Credentials (development only) ──────────────────
# These are used to seed the initial admin account
ADMIN_EMAIL=admin@popto.local
ADMIN_PASSWORD=ChangeThisAdminPassword

# ── Editor Credentials (development only) ─────────────────
EDITOR_EMAIL=editor@popto.local
EDITOR_PASSWORD=ChangeThisEditorPassword

# ── Application ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=POPTO

# ── Payment Gateway (future) ─────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ── Supabase (optional, for cloud deployment) ────────────
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Image Upload ──────────────────────────────────────────
MAX_IMAGE_SIZE_MB=5
UPLOAD_DIR=./public/uploads
